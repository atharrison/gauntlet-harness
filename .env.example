# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Static token (hackathon only) — replaced by GitHub OAuth in v1
# GITHUB_TOKEN=
# GitHub OAuth App (v1+)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to sign in (Phase 1 allowlist).
# Leave empty to allow all GitHub accounts (local dev only — see ATH-26).
ALLOWED_GITHUB_USERS=

# ── Ticket tracker ────────────────────────────────────────────────────────────
TICKET_PROVIDER=linear
LINEAR_API_KEY=

# ── Memory ────────────────────────────────────────────────────────────────────
# "supabase" for web/team-shared, "sqlite" for CLI/local
MEMORY_PROVIDER=supabase

# Supabase — used for SupabaseMemoryStore + auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project ref (from Supabase dashboard URL) — used by Supabase CLI
SUPABASE_PROJECT_REF=

# Public base URL — required in production to override Railway's internal bind address.
# Leave unset for local dev (falls back to x-forwarded-* headers then request origin).
NEXT_PUBLIC_SITE_URL=

# ── Delivery ──────────────────────────────────────────────────────────────────
# "web" | "cli"
DELIVERY=web

# ── Guardrails ────────────────────────────────────────────────────────────────
# Set true in dev to prevent writing to GitHub PR
DRY_RUN=false
MAX_TURNS=20
MAX_TOKENS=200000
TIMEOUT_MS=300000
# Max external context lookups (codebase search, past reviews) per run
SCOPE_BUDGET=10
# PR size gate: warn above these thresholds
PR_MAX_FILES=50
PR_MAX_LINES=3000

# ── Observability ─────────────────────────────────────────────────────────────
# Set to NONE to disable tracing (recommended for local dev — the default
# console exporter floods stdout). Lowercase `none` is also accepted.
OTEL_TRACES_EXPORTER=NONE
# Leave blank to emit OTel spans to stdout when tracing is enabled.
# Set to your OTLP endpoint for Langfuse, SigNoz, Datadog, etc.
OTEL_EXPORTER_OTLP_ENDPOINT=
